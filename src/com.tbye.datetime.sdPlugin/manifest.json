{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"SDKVersion": 3,
	"Author": "Ty Bye",
	"UUID": "com.tbye.datetime",
	"CodePath": "bin/plugin.js",
	"Description": "Display dates, times and segments of dates and times.",
	"Name": "DateTime Segments",
	"Icon": "actions/template/assets/plugin_icon",
	"URL": "https://tbye.com/projects/stream-deck-plugins/datetime/",
	"SupportURL": "https://github.com/tbye/tbye-sdp-datetime/issues",
	"Version": "1.1.0.0",
	"Nodejs": {
		"Version": "20"
	},
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Category": "DateTime Segments",
	"CategoryIcon": "actions/template/assets/cat_icon",
	"Actions": [
		{
			"Icon": "actions/template/assets/action_icon",
			"Name": "DateTime Segments",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "actions/template/assets/key_icon",
					"TitleAlignment": "middle",
					"FontSize": 16
				}
			],
			"Tooltip": "Display dates, times, and date/time segments. Press to copy the current value.",
			"UserTitleEnabled": false,
			"SupportedInMultiActions": true,
			"UUID": "com.tbye.datetime.action",
			"PropertyInspectorPath": "ui/inspector.html"
		}
	]
}